# copie para .env e ajuste antes de subir
POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=changeme

API_PORT=8080
WEB_PORT=8081
# embutido no bundle do front em build time (Vite não lê env em runtime) —
# mudou, precisa rebuildar a imagem `web`.
VITE_API_BASE_URL=http://localhost:8080/api/v1
ENV=production
# ENV=development libera CORS pro Vite local (http://localhost:5173) e cookie
# de sessão sem Secure. Nunca use development em produção.
# CORS_ORIGINS=http://localhost:5173  # opcional: sobrescreve o default de dev

# Agent Gateway (Fatia 3, 01-arquitetura.md §6.1.1) — só o serviço `worker`
# usa isto. Sem LLM_API_KEY, o worker sobe do mesmo jeito e A1/A2 ficam em
# modo fallback determinístico (04-agentes.md §5) — nada quebra, você só não
# vê ação/trilha gerada por agente de verdade.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# nomes de modelo do catálogo atual do provedor — não são fixados em
# nenhum doc de propósito, porque mudam em semanas (01-arquitetura.md §6.1.1)
LLM_MODEL_FAST=
LLM_MODEL_BALANCED=
LLM_MODEL_STRONG=
# teto mensal (01-arquitetura.md §6.3): 80% rebaixa strong -> balanced,
# 100% só deixa passar fast.
LLM_MONTHLY_BUDGET_USD=10
# preço por milhão de tokens, conforme a tabela do provedor pro modelo
# escolhido em cada tier — usado só pra estimar cost_usd em agent_call.
LLM_PRICE_FAST_IN_PER_M=0
LLM_PRICE_FAST_OUT_PER_M=0
LLM_PRICE_BALANCED_IN_PER_M=0
LLM_PRICE_BALANCED_OUT_PER_M=0
LLM_PRICE_STRONG_IN_PER_M=0
LLM_PRICE_STRONG_OUT_PER_M=0
LLM_TIMEOUT_SECONDS=30
